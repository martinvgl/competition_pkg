<?xml version="1.0"?>
<package format="3">

  <name>competition_pkg</name>
  <version>0.0.0</version>

  <description>Emergency evacuation robot — TurtleBot3 · ROS 2 · YASMIN · OpenCV · YOLO · Nav2</description>

  <maintainer email="ros2@todo.todo">ros2</maintainer>

  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- ROS 2 core -->
  <depend>rclpy</depend>

  <!-- Messages -->
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>

  <!-- Camera -->
  <depend>cv_bridge</depend>

  <!-- TF2 — required by obstacle_mapper_node for pose lookup at scan timestamp -->
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Navigation stack -->
  <depend>turtlebot3_navigation2</depend>

  <!-- YASMIN state machine -->
  <depend>yasmin</depend>
  <depend>yasmin_viewer</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>
